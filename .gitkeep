
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
    color: #333;
}

header {
    background-color: #2563eb;
    color: white;
    padding: 20px;
}

header h1 {
    margin-bottom: 15px;
}

nav a {
    color: white;
    text-decoration: none;
    margin-right: 15px;
}

nav a:hover {
    color: yellow;
}

main {
    width: 90%;
    max-width: 1100px;
    margin: 30px auto;
    padding: 25px;
    background-color: white;
    border-radius: 8px;
}

h2 {
    color: #2563eb;
    margin-bottom: 15px;
}

p {
    margin-bottom: 12px;
}

img {
    max-width: 100%;
    height: auto;
}

button {
    background-color: #2563eb;
    color: white;
    border: none;
    padding: 10px 15px;
    border-radius: 5px;
    cursor: pointer;
}

button:hover {
    background-color: #1d4ed8;
}

input,
select,
textarea {
    width: 100%;
    padding: 10px;
    margin: 5px 0 15px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
}

th,
td {
    border: 1px solid #ccc;
    padding: 10px;
    text-align: left;
}

th {
    background-color: #dbeafe;
}

footer {
    background-color: #1e293b;
    color: white;
    text-align: center;
    padding: 20px;
}
